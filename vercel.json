{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": {
    "api/index.ts": {
      "maxDuration": 5000,
      "includeFiles": "{public/**,node_modules/.prisma/client/**,node_modules/@prisma/client/**}"
    }
  }
}
